+def smooth_coords(coord_list, roll_list, window):
+    """Temporal smoothing of the per-frame crop boxes (and head roll).
+
+    DWPose's landmark box jitters a few pixels frame to frame; because the
+    lower face is regenerated from whatever crop it gets, that jitter turns
+    into the generated mouth "swimming" against the face.  Boxes are averaged
+    over a centred window, but only inside a run of consecutive real boxes
+    whose IoU with the previous one is > 0.5 — never across a cut, a
+    placeholder frame, or a jump to a different face.
+    """
+    n = len(coord_list)
+    if window is None or int(window) <= 1 or n < 3:
+        return list(coord_list), list(roll_list)
+    window = int(window) | 1
+    half = window // 2
+    out, rout = list(coord_list), list(roll_list)
+    i = 0
+    while i < n:
+        if coord_list[i] == coord_placeholder:
+            i += 1
+            continue
+        j = i
+        while (j + 1 < n and coord_list[j + 1] != coord_placeholder
+               and _bbox_iou(coord_list[j], coord_list[j + 1]) > 0.5):
+            j += 1
+        if j - i + 1 >= 3:
+            arr = np.array([coord_list[k] for k in range(i, j + 1)], dtype=np.float64)
+            rarr = np.array([roll_list[k] for k in range(i, j + 1)], dtype=np.float64)
+            for m, k in enumerate(range(i, j + 1)):
+                a, b = max(0, m - half), min(len(arr), m + half + 1)
+                out[k] = tuple(int(round(v)) for v in arr[a:b].mean(0))
+                rout[k] = float(rarr[a:b].mean())
+        i = j + 1
+    return out, rout
+
+
+def unsharp(img, amount, sigma=1.0):
+    if amount <= 0:
+        return img
+    blur = cv2.GaussianBlur(img, (0, 0), sigma)
+    return cv2.addWeighted(img, 1.0 + amount, blur, -amount, 0)
+
